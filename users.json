import json
import os

def load_users():
    if os.path.exists("users.json"):
        with open("users.json", "r") as f:
            return json.load(f)
    return {"admin": "password123", "user": "userpass"}

def save_users(data):
    with open("users.json", "w") as f:
        json.dump(data, f)

 